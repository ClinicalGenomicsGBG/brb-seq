{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/ClinicalGenomicsGBG/brb-seq/main/assets/schema_input.json",
    "title": "ClinicalGenomicsGBG/brb-seq pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "udi": {
                "type": "string",
                "exists": true,
                "pattern": "^\\S+$",
                "errorMessage": "UDI must be provided and cannot contain spaces",
                "meta": ["udi"]
            },
            "barcode": {
                  "type": "string",
                  "exists": true,
                  "pattern": "^[ACTGN]+$",
                  "errorMessage": "Barcode must be provided and can only contain A, C, T, G, N characters"
            }
        },
        "required": ["sample", "udi", "barcode"],
        "additionalProperties": true
    }
}
